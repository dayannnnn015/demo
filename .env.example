# Runtime uses a restricted edunexus_app login, NEVER postgres or service_role.
# For Supabase use the transaction pooler (port 6543) and edunexus_app.PROJECT_REF.
DATABASE_URL=postgresql://edunexus_app:CHANGE_ME@127.0.0.1:5432/edunexus
DATABASE_SSL=false
# Local/operator use ONLY. Do not set this on Vercel.
MIGRATION_DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/edunexus
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3001
# Account service. Omit both to keep creating identities in the Supabase dashboard.
# The service-role key belongs in that function's secrets, NEVER here.
PROVISION_FUNCTION_URL=https://YOUR_PROJECT.supabase.co/functions/v1/create-staff-identity
PROVISION_FUNCTION_SECRET=CHANGE_ME_32_OR_MORE_RANDOM_CHARACTERS
PORT=3001
LOG_LEVEL=info
