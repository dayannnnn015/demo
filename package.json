{
  "name": "edunexus",
  "version": "0.20.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/dev.ts",
    "build": "tsc -p tsconfig.build.json && esbuild web/account.ts --bundle --minify --format=esm --target=es2022 --outfile=public/account.js",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env dist/src/dev.js",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:bootstrap": "tsx --env-file-if-exists=.env scripts/bootstrap.ts",
    "db:credentials": "tsx --env-file-if-exists=.env scripts/runtime-credentials.ts",
    "api:export": "tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "@vercel/functions": "3.9.6",
    "cors": "2.8.6",
    "csv-parse": "7.0.2",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "esbuild": "0.28.2",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
